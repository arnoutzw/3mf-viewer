%% === STATE DIAGRAM ===
stateDiagram-v2
    [*] --> Initializing

    Initializing --> DropZoneVisible : Scene ready

    state DropZoneVisible {
        [*] --> WaitingForFile
        WaitingForFile --> DragHover : File dragged over
        DragHover --> WaitingForFile : Drag leave
        DragHover --> FileDropped : File released
        WaitingForFile --> FileDropped : Browse button click
        WaitingForFile --> GalleryOpen : Click Gallery
    }

    state GalleryOpen {
        [*] --> GalleryGrid
        GalleryGrid --> GallerySearch : Type search
        GallerySearch --> GalleryGrid : Clear search
        GalleryGrid --> ModelSelected : Click model card

        state "Admin Section" as AdminGallery {
            UploadForm --> Uploading : Select file
            Uploading --> GalleryGrid : Upload complete
        }
    }

    GalleryOpen --> DropZoneVisible : Click back
    ModelSelected --> LoadingModel : Fetch from storage

    FileDropped --> LoadingModel : Parse file

    state LoadingModel {
        [*] --> Parsing
        Parsing --> BuildingScene : Geometry ready
        BuildingScene --> FittingCamera : Meshes added
    }

    LoadingModel --> ModelViewing : Model loaded

    state ModelViewing {
        [*] --> InteractiveView
        InteractiveView --> WireframeView : Toggle wireframe
        WireframeView --> InteractiveView : Toggle wireframe
        InteractiveView --> SliceView : Toggle slice mode
        SliceView --> InteractiveView : Toggle slice mode

        InteractiveView --> QuoteMode : Click quote button
        QuoteMode --> InteractiveView : Close quote panel

        state QuoteMode {
            [*] --> SelectMaterial
            SelectMaterial --> SelectColor : Material chosen
            SelectColor --> AdjustSettings : Color chosen
            AdjustSettings --> QuoteReady : Price calculated
            QuoteReady --> QuoteRequested : Click request
        }

        InteractiveView --> ObjectsPanel : Toggle objects panel
        InteractiveView --> PlateSelection : Switch plate (3MF only)
    }

    ModelViewing --> DropZoneVisible : Click open new file
    ModelViewing --> GalleryOpen : Click gallery
    ModelViewing --> LoadingModel : Drop new file
