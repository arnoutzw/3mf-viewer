%% ============================================================
%% Bambu 3MF Viewer (bambu-viewer/index.html) — UML Diagrams
%% Three.js WebGPU/WebGL 3D viewer with gallery + print quoting
%% ============================================================

%% === CLASS DIAGRAM ===
classDiagram
    class ViewerApp {
        -scene: THREE.Scene
        -camera: THREE.PerspectiveCamera
        -renderer: THREE.WebGPURenderer | THREE.WebGLRenderer
        -controls: OrbitControls
        -rendererBackend: string
        -modelCenter: THREE.Vector3
        -modelSize: THREE.Vector3
        -currentPlateIndex: number
        -plates: array
        -objectMap: Map
        -isAdmin: boolean
        -quoteMode: boolean
        +init()
        +animate()
        +loadFile(file)
        +loadUrl(url)
        +clearScene()
        +fitCamera()
        +updateFPS()
    }

    class ThreeMFParser {
        +parse3MF(arrayBuffer) object
        +extractPlates(data) array
        +extractObjects(plate) array
        +assignColors(objects, filaments)
    }

    class STLParser {
        +parseSTL(arrayBuffer) THREE.BufferGeometry
        +calculateVolume(geometry) number
        +calculateBoundingBox(geometry) THREE.Box3
    }

    class OBJParser {
        +parseOBJ(text) THREE.Group
    }

    class STEPParser {
        +parseSTEP(arrayBuffer) THREE.Group
    }

    class DXFParser {
        +parseDXF(text) THREE.Group
    }

    class SceneManager {
        -buildPlate: THREE.Group
        -gridHelper: THREE.GridHelper
        -ambientLight: THREE.AmbientLight
        -directionalLights: array
        +setupScene()
        +setupLighting()
        +setupBuildPlate()
        +toggleWireframe(enabled)
        +toggleGrid(enabled)
        +toggleAxes(enabled)
        +toggleModelNames(enabled)
        +setProjection(type)
        +resetCamera()
        +applySlicePlane(height)
    }

    class GalleryManager {
        -galleryDb: Firestore
        -galleryStorage: Firebase.Storage
        -galleryAuth: Firebase.Auth
        -models: array
        -searchQuery: string
        +loadGallery()
        +searchModels(query)
        +renderGallery()
        +loadGalleryModel(modelId)
        +uploadModel(file, metadata)
        +deleteModel(modelId)
    }

    class QuoteEngine {
        -PRICING: object
        -selectedMaterial: string
        -selectedColor: string
        -selectedQuality: string
        -infillPercent: number
        -infillType: string
        +calculateQuote() object
        +estimateWeight(volume, infill, material) number
        +estimatePrintTime(volume, layerHeight) number
        +estimateCost(weight, material, time) number
        +renderQuotePanel()
        +renderFloatingQuoteCard()
        +submitQuoteRequest()
    }

    class ObjectsPanel {
        -objectList: array
        +renderObjectList()
        +toggleObjectVisibility(id)
        +setObjectColor(id, color)
        +setObjectQuantity(id, qty)
        +selectFilamentForObject(id, filament)
    }

    class PlateSidebar {
        -plateList: array
        +renderPlates()
        +selectPlate(index)
    }

    class ToolbarManager {
        +toggleWireframe()
        +toggleGrid()
        +toggleAxes()
        +toggleAutoRotate()
        +toggleProjection()
        +toggleModelNames()
        +captureScreenshot()
        +measureDistance()
        +toggleSliceMode()
        +openQuotePanel()
    }

    class DropZone {
        +show()
        +hide()
        +handleDragOver(event)
        +handleDragLeave(event)
        +handleDrop(event)
    }

    class FilamentPicker {
        -filaments: array
        -selectedFilament: object
        +loadFilaments()
        +renderSwatches()
        +selectFilament(id)
    }

    class ThemeBridge {
        +applyTheme(theme)
        +listenForPortalTheme()
    }

    class PricingAdmin {
        +PRICING: object
        +openModal()
        +savePricing()
        +loadPricing()
    }

    ViewerApp --> ThreeMFParser : parses 3MF
    ViewerApp --> STLParser : parses STL
    ViewerApp --> OBJParser : parses OBJ
    ViewerApp --> STEPParser : parses STEP
    ViewerApp --> DXFParser : parses DXF
    ViewerApp --> SceneManager : manages scene
    ViewerApp --> GalleryManager : model gallery
    ViewerApp --> QuoteEngine : print quoting
    ViewerApp --> ObjectsPanel : object list
    ViewerApp --> PlateSidebar : plate selection
    ViewerApp --> ToolbarManager : toolbar actions
    ViewerApp --> DropZone : file drop
    ViewerApp --> FilamentPicker : filament selection
    ViewerApp --> ThemeBridge : theme sync
    ViewerApp --> PricingAdmin : pricing config

%% === SEQUENCE DIAGRAM: Page Load + File Drop ===
sequenceDiagram
    participant User
    participant Viewer as Viewer App
    participant CDN as CDN (Three.js, Firebase)
    participant WebGPU as WebGPU/WebGL
    participant Portal as Portal (parent)

    User->>Viewer: Open bambu-viewer/
    activate Viewer
    Viewer->>CDN: Load Tailwind CSS
    Viewer->>CDN: Load Three.js + addons (3MFLoader, STLLoader, etc.)
    Viewer->>CDN: Load Firebase SDK (app, auth, firestore, storage)
    CDN-->>Viewer: Scripts loaded

    Viewer->>Viewer: Initialize Firebase for gallery
    Viewer->>Viewer: Show Drop Zone (waiting for file)

    alt WebGPU available
        Viewer->>WebGPU: Request GPU adapter
        WebGPU-->>Viewer: GPU adapter
        Viewer->>Viewer: Create THREE.WebGPURenderer
        Viewer->>Viewer: rendererBackend = 'webgpu'
    else WebGPU not available
        Viewer->>Viewer: Create THREE.WebGLRenderer
        Viewer->>Viewer: rendererBackend = 'webgl'
    end

    Viewer->>Viewer: Setup scene (camera, lights, build plate, grid)
    Viewer->>Viewer: Setup OrbitControls
    Viewer->>Viewer: Start animation loop (requestAnimationFrame)
    deactivate Viewer

    opt Embedded in portal iframe
        Portal->>Viewer: postMessage({type: 'theme-change', theme})
        Viewer->>Viewer: Apply theme

        Portal->>Viewer: postMessage({type: 'admin-auth', ...})
        Viewer->>Viewer: _isAdmin = true
        Viewer->>Viewer: Show admin controls (gallery upload, pricing)
    end

    Note over User, Viewer: User drops a file

    User->>Viewer: Drag & drop file onto drop zone
    activate Viewer
    Viewer->>Viewer: handleDrop(event)
    Viewer->>Viewer: Read file as ArrayBuffer
    Viewer->>Viewer: Show loading overlay with progress bar

    alt File is .3mf
        Viewer->>Viewer: parse3MF(arrayBuffer)
        Viewer->>Viewer: Extract plates from 3MF data
        Viewer->>Viewer: For each plate: extract objects with geometry + colors
        Viewer->>Viewer: Build THREE.Mesh for each object
        Viewer->>Viewer: Show plate sidebar (if multiple plates)
    else File is .stl
        Viewer->>Viewer: STLLoader.parse(arrayBuffer)
        Viewer->>Viewer: Create single THREE.Mesh with geometry
        Viewer->>Viewer: Calculate volume for quoting
    else File is .obj
        Viewer->>Viewer: OBJLoader.parse(text)
        Viewer->>Viewer: Create THREE.Group with meshes
    else File is .step/.stp
        Viewer->>Viewer: STEPParser.parse(arrayBuffer)
        Viewer->>Viewer: Create mesh from B-rep data
    else File is .dxf
        Viewer->>Viewer: DXFParser.parse(text)
        Viewer->>Viewer: Create 2D line geometry
    end

    Viewer->>Viewer: Add model to scene
    Viewer->>Viewer: Calculate model center + bounding box
    Viewer->>Viewer: fitCamera() — zoom to fit model
    Viewer->>Viewer: Hide drop zone, show model name bar
    Viewer->>Viewer: Populate objects panel with part list
    Viewer->>Viewer: Show floating quote card (if STL/3MF)
    Viewer->>Viewer: Hide loading overlay
    deactivate Viewer

%% === SEQUENCE DIAGRAM: Gallery Browse + Load ===
sequenceDiagram
    participant User
    participant Viewer as Viewer App
    participant Firestore as Firestore DB
    participant Storage as Firebase Storage

    User->>Viewer: Click "Browse Gallery" button
    activate Viewer
    Viewer->>Viewer: Show gallery panel
    Viewer->>Firestore: galleryDb.collection('gallery').get()
    activate Firestore
    Firestore-->>Viewer: gallery models list
    deactivate Firestore
    Viewer->>Viewer: Render gallery grid with cards (thumbnail, name, tags)
    deactivate Viewer

    User->>Viewer: Type in search box
    Viewer->>Viewer: Filter models by name/tags
    Viewer->>Viewer: Re-render gallery grid

    User->>Viewer: Click gallery card
    activate Viewer
    Viewer->>Viewer: Show loading overlay
    Viewer->>Storage: Fetch model file URL from gallery doc
    activate Storage
    Storage-->>Viewer: Model file ArrayBuffer
    deactivate Storage
    Viewer->>Viewer: clearScene()
    Viewer->>Viewer: Parse model (STL/3MF/OBJ)
    Viewer->>Viewer: Add to scene, fitCamera()
    Viewer->>Viewer: Hide gallery panel
    Viewer->>Viewer: Show model in viewer
    deactivate Viewer

    opt Admin uploads model
        User->>Viewer: Fill name, description, tags
        User->>Viewer: Select file
        activate Viewer
        Viewer->>Storage: Upload model file to gallery/
        activate Storage
        Storage-->>Viewer: Download URL
        deactivate Storage
        Viewer->>Firestore: Add gallery doc {name, desc, tags, url, uploadedAt}
        Firestore-->>Viewer: success
        Viewer->>Viewer: Refresh gallery grid
        deactivate Viewer
    end

%% === SEQUENCE DIAGRAM: Print Quote Flow ===
sequenceDiagram
    participant User
    participant Viewer as Viewer App
    participant QuoteEngine as Quote Engine

    Note over Viewer: Model loaded, volume calculated

    User->>Viewer: Click quote toolbar button
    activate Viewer
    Viewer->>Viewer: quoteMode = true
    Viewer->>Viewer: Hide objects panel, show quote panel
    Viewer->>QuoteEngine: Render material buttons (PLA, PETG, ABS, TPU, etc.)
    deactivate Viewer

    User->>Viewer: Select material (e.g., PLA)
    activate QuoteEngine
    QuoteEngine->>QuoteEngine: Load filament colors for material
    QuoteEngine->>Viewer: Render color swatches
    deactivate QuoteEngine

    User->>Viewer: Select color swatch
    User->>Viewer: Adjust quality (layer height dropdown)
    User->>Viewer: Adjust infill % (slider)
    User->>Viewer: Select infill pattern

    activate QuoteEngine
    QuoteEngine->>QuoteEngine: estimateWeight(volume, infill%, material_density)
    QuoteEngine->>QuoteEngine: estimatePrintTime(volume, layerHeight)
    QuoteEngine->>QuoteEngine: estimateCost(weight, material, time)
    Note over QuoteEngine: Cost = materialCost + timeCost + setupFee
    QuoteEngine->>Viewer: Update breakdown display
    QuoteEngine->>Viewer: Update total price in quote panel
    QuoteEngine->>Viewer: Update floating quote card
    deactivate QuoteEngine

    User->>Viewer: Click "Request Quote"
    activate Viewer
    Viewer->>Viewer: Open email mailto: with pre-filled quote details
    deactivate Viewer

